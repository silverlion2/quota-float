{
  "name": "quota-float",
  "description": "Local-first desktop quota monitor for Codex, Claude, Qoder, TRAE, WorkBuddy, Volcengine Ark Coding Plan, and Google Antigravity. Built with Tauri for Windows and macOS.",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc && vite build --configLoader native",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:e2e": "cross-env VITE_WDIO=1 tsc && cross-env VITE_WDIO=1 vite build --configLoader native",
    "test:e2e:build": "tauri build --features wdio --config src-tauri/tauri.e2e.conf.json --no-bundle",
    "test:e2e": "wdio run wdio.conf.ts",
    "version:check": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs",
    "check:codex": "powershell -ExecutionPolicy Bypass -File scripts/check-codex-update.ps1",
    "test": "vitest run --configLoader native",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@wdio/cli": "^9.31.2",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "cross-env": "^10.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.1",
    "deepmerge-ts": "^8.0.2",
    "serialize-javascript": "^7.1.0"
  }
}
