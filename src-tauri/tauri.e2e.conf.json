{
  "productName": "Quota Float E2E",
  "identifier": "app.quotafloat.desktop.e2e",
  "build": {
    "beforeBuildCommand": "npm run build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default", "focus-panel", "e2e"]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false
  }
}
